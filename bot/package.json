{
  "name": "discord-advanced-bot",
  "version": "2.0.0",
  "description": "An advanced Discord bot with 18+ commands, RPC support, and detailed system information",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "logs": "tail -f logs/bot-*.log",
    "clear-logs": "rm -rf logs/*.log",
    "stats": "node -e \"console.log(require('os').loadavg()[0].toFixed(2) + '%')\"",
    "check": "node -e \"console.log(require('discord.js').version)\"",
    "update": "npm update && npm audit fix"
  },
  "keywords": [
    "discord",
    "bot",
    "discord-bot",
    "discord-js",
    "rpc",
    "rich-presence",
    "advanced-bot",
    "utility-bot",
    "moderation",
    "information",
    "system-info"
  ],
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com",
    "url": "https://github.com/yourusername"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/discord-advanced-bot.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/discord-advanced-bot/issues"
  },
  "homepage": "https://github.com/yourusername/discord-advanced-bot#readme",
  "engines": {
    "node": ">=16.9.0"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.3.1",
    "os": "^0.1.2",
    "process": "^0.11.10",
    "fs": "^0.0.1-security",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
